# ====================================
# Configuração do Gemini File Search RAG
# ====================================

# Google Gemini API Configuration
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# Google Gemini File Search Store
# Crie usando o script: ./create-gemini-store.sh
# Formato: fileSearchStores/xxxxxxxxxxxxx
GEMINI_STORE_NAME=fileSearchStores/xxxxxxxxxxxxx

# ====================================
# Notas:
# ====================================
# 1. Copie este arquivo para .env e preencha com seus valores
# 2. NUNCA faça commit do arquivo .env no git
# 3. Reinicie o n8n após alterar este arquivo
# 4. OpenAI API Key deve ser configurada via interface do n8n (Settings > Credentials)
