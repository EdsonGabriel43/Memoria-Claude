            }
          ]
        },
        "options": {}
      },
      "id": "7e1f934d-b07b-4983-818b-90774bd2baa5",
      "name": "Upload File to Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        608,
        272
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/{{ $env.GEMINI_STORE_NAME }}:importFile",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $env.GEMINI_API_KEY }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"fileName\": \"{{ $json.file.name }}\",\n  \"customMetadata\": [\n    {\n      \"key\": \"upload_date\",\n      \"stringValue\": \"{{ $now.format('yyyy-MM-dd HH:mm:ss') }}\"\n    },\n    {\n      \"key\": \"source\",\n      \"stringValue\": \"n8n-workflow\"\n    },\n    {\n      \"key\": \"original_filename\",\n      \"stringValue\": \"{{ $('Prepare Upload Data').item.json.filename }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "a7b5ef07-ce63-46bd-93b6-aca895480f6f",
      "name": "Import to Store",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        832,
        272
      ]
    },
    {
      "parameters": {
        "jsCode": "// Return success message with file info\nconst uploadResult = $input.item.json;\nconst originalData = $('Prepare Upload Data').item.json;\n\nreturn {\n  json: {\n    success: true,\n    message: 'File uploaded and indexed successfully!',\n    filename: originalData.filename,\n    fileUri: uploadResult.file?.uri || 'N/A',\n    storeName: $env.GEMINI_STORE_NAME,\n    uploadedAt: new Date().toISOString()\n  }\n};"
      },
