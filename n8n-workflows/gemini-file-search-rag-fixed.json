      "parameters": {
        "toolDescription": "Use esta ferramenta SEMPRE que o usuário fizer uma pergunta sobre documentos, conteúdo, arquivos ou quiser informações. Não hesite, chame imediatamente.",
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-exp:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendHeaders": true,
        "headerParameters": {
